# Copia este archivo a `.env` y rellena los valores.
# El `.env` real está en .gitignore y NO se sube al repositorio.

# Dashboard de Supabase -> Project Settings -> Data API
EXPO_PUBLIC_SUPABASE_URL=https://<tu-project-ref>.supabase.co

# Clave "publishable" (sb_publishable_...). Es segura en el cliente
# SIEMPRE que las políticas RLS estén bien configuradas.
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
